# Koneksi MySQL (Laragon — MySQL 8.4, root tanpa password)
DATABASE_URL="mysql://root:@127.0.0.1:3306/noblesse"

# Rahasia untuk sesi admin (ganti dengan string acak panjang di produksi)
SESSION_SECRET="dev-secret-ganti-di-produksi-9f3a7c1e"

# URL publik situs — wajib untuk adapter-node (proteksi CSRF & cookie di belakang proxy)
ORIGIN="https://noblessegroup.id"

# Batas ukuran body request adapter-node (default 512KB terlalu kecil untuk
# upload gambar hingga 5MB). Samakan/lebih besar dari MAX_BYTES di
# src/routes/api/admin/upload/+server.ts dan client_max_body_size di Nginx.
BODY_SIZE_LIMIT=6291456

# Kunci AES-256-GCM (32-byte hex) untuk enkripsi kode voucher di URL QR
# (/verify/[token]). JANGAN diubah setelah voucher aktif beredar — token lama
# akan gagal didekripsi jika key berganti. Generate baru dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_TOKEN_KEY="9530dae2a308b7c3d81b2b9e29d8519e79a4f5c5851715174bb99ff9a1279ed0"
